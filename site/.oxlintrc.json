{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "rules": {
    "typescript/prefer-readonly-parameter-types": "off"
  }
}
